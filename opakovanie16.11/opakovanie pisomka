    <?php
    $pole = [4, 23, 56, 23, 5, 66, 12, 2];
    $sucetparnych = 0;
    $sucetneparnych = 0;
    foreach ($pole as $cislo){
        if ($cislo % 2 == 0){
            $sucetparnych = $sucetparnych + $cislo;
        }
        else{
            $sucetneparnych = $sucetneparnych + $cislo;
        }
    }
    echo "Sucet parnych cisel je: " . $sucetparnych;
    echo "Sucet neparnych cisel je: " . $sucetneparnych;
    echo "<br>";
